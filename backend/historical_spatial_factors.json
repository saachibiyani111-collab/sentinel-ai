  "_meta": {
    "description": "Historical relative composite-AQI burden indicators for Sentinel AI analysis locations.",
    "method": "Median of paired hourly ratios: target-location composite AQI divided by the mean composite AQI of at least three simultaneously reporting OTHER monitoring locations.",
